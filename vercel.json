{
  "redirects": [
    { "source": "/cv", "destination": "/about/", "permanent": false },
    { "source": "/cv/", "destination": "/about/", "permanent": false },
    { "source": "/cv.md", "destination": "/about/", "permanent": false },
    { "source": "/AmroElhusseini_Resume.pdf", "destination": "/about/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/blog/(.*)\\.webp",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, immutable" }
      ]
    },
    {
      "source": "/notes/(.*)\\.webp",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, immutable" }
      ]
    }
  ]
}
