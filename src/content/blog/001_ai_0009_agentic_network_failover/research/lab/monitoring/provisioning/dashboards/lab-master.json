      "targets": [
        {
          "refId": "A",
          "expr": "max(path_state_active{lab=\"agt\"})",
          "legendFormat": "{{next_hop}}",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO ROUTE",
                  "color": "red"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ROUTING",
                  "color": "green"
                }
              }
            }
          ]
        }
      }
    },
