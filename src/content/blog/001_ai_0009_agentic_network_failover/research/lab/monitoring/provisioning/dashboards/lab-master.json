{
  "uid": "lab-master",
  "title": "Agentic Failover Lab - Master",
  "tags": [
    "lab",
    "failover"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Live topology - both labs",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "nodeGraph",
      "id": 2,
      "title": "AGENT LAB (static routes + LangGraph agent)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(device_up_up{lab=\"agt\"})",
          "legendFormat": "{{device}}",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "max(path_state_active{lab=\"agt\"})",
          "legendFormat": "path",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "max(path_state_reachable{lab=\"agt\"})",
          "legendFormat": "reach",
          "instant": true
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "nodeGraph",
      "id": 3,
      "title": "OSPF LAB (control)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
