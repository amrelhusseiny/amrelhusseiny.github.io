        {
          "refId": "B",
          "expr": "max(path_state_active{lab=\"ospf\"})",
          "legendFormat": "path",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "max(path_state_reachable{lab=\"ospf\"})",
          "legendFormat": "reach",
          "instant": true
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
