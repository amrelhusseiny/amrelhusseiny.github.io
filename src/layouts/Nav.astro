---
// Printed-catalog header: brand left, nav right, minimal chrome.
const path = Astro.url.pathname;

const items = [
  { href: "/blog/", label: "Blog" },
  { href: "/notes/", label: "Notes" },
  { href: "/drawings/", label: "Drawings" },
  { href: "/about/", label: "About" },
  { href: "/cv/", label: "CV" },
];

const isActive = (href) => path !== "/" && (path === href || path.startsWith(href));
---
<header class="site-header">
  <a href="/" class="site-brand" aria-label="Amro's Blog — home">
    <svg class="brand-mark" width="67" height="18" viewBox="0 0 67 18" aria-hidden="true">
      <g fill="#c8c8c8"><rect x="0" y="3" width="12" height="12" /></g>
      <g fill="#a3a3a3">
        <line x1="12.5" x2="18" y1="9" y2="9" stroke="#a3a3a3" stroke-width="1" />
        <polygon points="21,9 18,7 18,11" />
        <rect x="22" y="3" width="12" height="12" rx="2" />
      </g>
      <g fill="#4d4d4d">
        <line x1="34.5" x2="40" y1="9" y2="9" stroke="#4d4d4d" stroke-width="1" />
        <polygon points="43,9 40,7 40,11" />
        <polygon points="50,2 57,9 50,16 43,9" />
      </g>
      <g fill="#000000">
        <line x1="57.5" x2="61" y1="9" y2="9" stroke="#000000" stroke-width="1" />
        <circle cx="63" cy="9" r="4" />
      </g>
    </svg>
    <span>Amro's Blog</span>
  </a>

  <nav class="site-nav" aria-label="Main">
    {items.map((it) => (
      <a
        href={it.href}
        class:list={["site-nav-link", { active: isActive(it.href) }]}
        aria-current={isActive(it.href) ? "page" : undefined}
      >
        {it.label}
      </a>
    ))}
  </nav>

  <div class="site-social" aria-label="Elsewhere">
    <a href="https://github.com/amrelhusseiny" target="_blank" rel="noreferrer noopener me" aria-label="GitHub" class="site-social-link">
      <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.58 9.58 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.18.58.69.48A10 10 0 0 0 12 2z"/></svg>
    </a>
    <a href="https://www.linkedin.com/in/amro-elhusseini-2a330456" target="_blank" rel="noreferrer noopener me" aria-label="LinkedIn" class="site-social-link">
      <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zM8.34 18.34V10.1H5.77v8.24h2.57zM7.05 9a1.49 1.49 0 1 0 0-2.98 1.49 1.49 0 0 0 0 2.98zm11.29 9.34v-4.52c0-2.42-1.29-3.55-3.02-3.55-1.39 0-2.02.77-2.37 1.31v-1.13h-2.57v8.24h2.57v-4.08c0-1.07.2-2.11 1.53-2.11 1.31 0 1.33 1.23 1.33 2.18v4.01h2.53z"/></svg>
    </a>
  </div>
</header>
