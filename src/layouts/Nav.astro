---
// Responsive M3 nav: drawer (desktop), rail (tablet), bottom bar (mobile)
const path = Astro.url.pathname;

const items = [
  { href: "/blog/", label: "Blog", icon: "M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" },
  { href: "/notes/", label: "Notes", icon: "M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" },
  { href: "/about/", label: "About", icon: "M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" },
  { href: "/cv/", label: "CV", icon: "M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" },
];

const isActive = (href) => path !== "/" && (path === href || path.startsWith(href));
---
<header class="nav-drawer" data-nav>
  <a href="/blog/" class="nav-brand">Amro's Blog</a>
  <nav class="nav-list" aria-label="Main">
    {items.map((it) => (
      <a href={it.href} class:list={["nav-item", { active: isActive(it.href) }]}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d={it.icon}/></svg>
        <span>{it.label}</span>
      </a>
    ))}
  </nav>
  <div class="nav-footer">
    <button type="button" class="nav-item" data-theme-toggle>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
        <path data-theme-icon-sun d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zm0 16a7 7 0 1 1 0-14 7 7 0 0 1 0 14z"/>
        <path data-theme-icon-moon d="M12 3a9 9 0 1 0 0 18V3z" style="display:none"/>
      </svg>
      <span data-theme-label>Light mode</span>
    </button>
    <div class="nav-social">
      <a href="https://github.com/amrelhusseiny" target="_blank" rel="noreferrer noopener me" aria-label="GitHub" class="nav-social-btn">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.58 9.58 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.18.58.69.48A10 10 0 0 0 12 2z"/></svg>
      </a>
      <a href="https://www.linkedin.com/in/amro-elhusseini-2a330456" target="_blank" rel="noreferrer noopener me" aria-label="LinkedIn" class="nav-social-btn">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zM8.34 18.34V10.1H5.77v8.24h2.57zM7.05 9a1.49 1.49 0 1 0 0-2.98 1.49 1.49 0 0 0 0 2.98zm11.29 9.34v-4.52c0-2.42-1.29-3.55-3.02-3.55-1.39 0-2.02.77-2.37 1.31v-1.13h-2.57v8.24h2.57v-4.08c0-1.07.2-2.11 1.53-2.11 1.31 0 1.33 1.23 1.33 2.18v4.01h2.53z"/></svg>
      </a>
    </div>
  </div>
</header>
