---
import "../styles/global.css";
import "@fontsource/geist-mono/400.css";
import "@fontsource/geist-mono/500.css";
import "@fontsource/geist-mono/600.css";
import "@fontsource/geist-mono/700.css";
import Nav from "./Nav.astro";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}
const { title, description, bodyClass = "" } = Astro.props;
const siteTitle = "Amro's Blog";
const pageTitle = title ? `${title} // ${siteTitle}` : siteTitle;
const desc = description ?? "Network engineer and automation advocate. Writing about networks, Linux, AI, and automation.";
---
<!doctype html>
<html lang="en-us" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="author" content="Amro El Husseini" />
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#ececec" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("amro_blog_theme");
          if (t !== "dark" && t !== "light") t = "light";
          document.documentElement.setAttribute("data-theme", t);
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", t === "dark" ? "#0c0c0c" : "#ececec");
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Speculation Rules: prerender likely-next navigations -->
    <script type="speculationrules">
      {
        "prerender": [
          { "where": { "href_matches": ["/blog/*", "/notes/*", "/drawings/", "/about/"] }, "eagerness": "moderate" }
        ]
      }
    </script>

    <!-- C2PA Content Credentials -->
    <link rel="contentcredentials" href="/.well-known/c2pa/contentcredentials.json" />

    <!-- GoatCounter analytics -->
    <script is:inline data-goatcounter="https://amro.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to main content</a>

    <Nav />

    <main id="main" class="page-main">
      <slot />
      <footer class="site-footer">
        <p>&copy; {new Date().getFullYear()} Amro El Husseini. All rights reserved.</p>
        <p class="site-footer-links">
          <a href="/blog/">Blog</a>
          <a href="/notes/">Notes</a>
          <a href="/drawings/">Drawings</a>
          <a href="/about/">About</a>
          <a href="/cv/">CV</a>
        </p>
      </footer>
    </main>

    <!-- Lightbox -->
    <dialog id="lightbox" aria-label="Image viewer">
      <div class="lightbox-inner">
        <img id="lightbox-img" src="" alt="" />
        <button class="lightbox-close" aria-label="Close image viewer">&#10005;</button>
      </div>
    </dialog>

    <button class="back-to-top" data-back-to-top aria-label="Back to top">&uarr;</button>

    <script>
      import "../lib/client";
    </script>

    <Analytics />
  </body>
</html>
