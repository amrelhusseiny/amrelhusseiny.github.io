---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Page not found">
  <section style="text-align:center;padding:80px 0;" data-reveal>
    <h1 style="font-size:3rem;margin-bottom:12px;">404</h1>
    <p style="color:var(--color-ink-soft);margin-bottom:24px;">This page doesn't exist.</p>
    <a class="share-btn" href="/blog/">Back to Blog</a>
  </section>
</Layout>
