---
import Layout from "../../layouts/Layout.astro";
import BlogList from "../../components/BlogList.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout title="Blog" description="Technical blog on networks, Linux, AI, and automation.">
  <section class="section-head">
    <h1>Blog</h1>
    <span class="more-link">{String(posts.length).padStart(2, "0")} entries</span>
  </section>

  <div class="search-wrap">
    <label class="kicker" for="blog-search">Search the archive</label>
    <input id="blog-search" class="search-input" type="search" placeholder="Type to filter&hellip;" autocomplete="off" />
  </div>

  <BlogList posts={posts} />

  <p id="search-empty" class="search-empty" style="display:none">No articles match your search.</p>

  <script>
    const input = document.getElementById("blog-search");
    const cards = document.querySelectorAll("#blog-cards .post-card");
    const empty = document.getElementById("search-empty");
    input?.addEventListener("input", () => {
      const term = input.value.trim().toLowerCase();
      let visible = 0;
      cards.forEach((c) => {
        const match = !term || c.textContent.toLowerCase().includes(term);
        c.style.display = match ? "" : "none";
        if (match) visible++;
      });
      if (empty) empty.style.display = visible === 0 && term ? "" : "none";
    });
  </script>
</Layout>
