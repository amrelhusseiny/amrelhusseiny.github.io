---
import Layout from "../layouts/Layout.astro";
---
<Layout
  title="Amro's Blog"
  description="Amro El Husseini — network engineer and automation advocate. Writing about networks, Linux, AI, and automation."
  bodyClass="home-page"
>
  <section class="home-hero" aria-label="Welcome">
    <div class="home-hero-bg" aria-hidden="true"></div>
    <div class="home-hero-overlay" aria-hidden="true"></div>

    <div class="home-hero-content">
      <p class="home-eyebrow">Amro El Husseini</p>
      <h1 class="home-title">Amro's Blog</h1>
      <p class="home-tagline">Networks, Linux, AI &amp; automation &mdash; and the occasional sketch.</p>

      <nav class="home-links" aria-label="Site sections">
        <a class="home-link" href="/blog/">Blog</a>
        <a class="home-link" href="/notes/">Notes</a>
        <a class="home-link" href="/drawings/">Drawings</a>
        <a class="home-link" href="/about/">About</a>
        <a class="home-link" href="/cv/">CV</a>
      </nav>
    </div>

    <a class="home-scroll" href="#main-end" aria-label="Scroll down">
      <span class="home-scroll-dot" aria-hidden="true"></span>
    </a>
  </section>

  <span id="main-end"></span>
</Layout>
