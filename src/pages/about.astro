---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { books } from "../lib/books";
import { readingMinutes } from "../lib/format";
import { timeline } from "../lib/timeline";
import { links } from "../lib/links";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const skills = [
  { title: "Network Engineering", years: "8+ years", chips: ["BGP / MPLS / OSPF", "Routing & Switching", "Palo Alto / Cisco ASA", "Juniper MX / SRX"] },
  { title: "Network Automation", years: "6+ years", chips: ["Python", "REST API / NetConf", "MCP Servers", "N8N"] },
  { title: "Cloud & Virtualisation", years: "5+ years", chips: ["OpenStack Neutron", "Arista (DC)", "Terraform", "Docker"] },
  { title: "Linux & Observability", years: "6+ years", chips: ["Linux Admin", "Grafana / InfluxDB", "Telegraf", "SolarWinds NPM"] },
];
---
<Layout title="About" description="About Amro El Husseini — network engineer and automation advocate.">
  <section class="page-intro">
    <p class="kicker">About / Profile</p>
    <h1>Amro El Husseini</h1>
    <p class="muted">Senior Network &amp; Cloud Engineer · Automation Advocate</p>
    <p class="kicker">Frankfurt am Main, Germany</p>
    <div class="button-row">
      <a class="btn" href="/cv/">CV</a>
      <a class="btn" href="https://www.linkedin.com/in/amro-elhusseini-2a330456" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a class="btn" href="https://github.com/amrelhusseiny" target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
  </section>

  <section class="page-section">
    <div class="section-head">
      <h2>Profile</h2>
      <span class="more-link">01</span>
    </div>
    <div class="post-content">
      <p>Network Engineer focused on automation, cloud networking, and Linux internals.</p>
      <p>I design and operate resilient network platforms, then automate repetitive operations with Python and Ansible.</p>
      <p>I use this blog to share practical labs, implementation notes, and lessons from production environments.</p>
    </div>
  </section>

  <section class="page-section">
    <div class="section-head">
      <h2>Expertise</h2>
      <span class="more-link">04 areas</span>
    </div>
    <div class="card-grid">
      {skills.map((s) => (
        <div class="catalog-card">
          <h3>{s.title}</h3>
          <p class="years">{s.years}</p>
          <div class="tag-row">
            {s.chips.map((c) => <span class="post-card-tag">{c}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="page-section">
    <div class="section-head">
      <h2>Work experience</h2>
      <span class="more-link">{String(timeline.length).padStart(2, "0")} roles</span>
    </div>
    <div class="timeline-list">
      {timeline.map((t) => (
        <div class="timeline-item">
          <div class="timeline-date">{t.date}</div>
          <div>
            <h3>{t.title}</h3>
            <p class="company">{t.company}</p>
            {t.achievement && <p class="achievement">{t.achievement}</p>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="page-section">
    <div class="section-head">
      <h2>Featured posts</h2>
      <a class="more-link" href="/blog/">All entries &gt;</a>
    </div>
    <div class="entry-list">
      {posts.map((p) => (
        <a href={`/blog/${p.id}/`} class="entry-row">
          <span class="entry-meta">
            {p.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
            &middot; {readingMinutes(p.body)} min
          </span>
          <span class="entry-title">{p.data.title}</span>
          <span class="entry-tag">{p.data.tags?.[0] ? `#${p.data.tags[0]}` : ">"}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="page-section">
    <div class="section-head">
      <h2>Reading corner</h2>
      <span class="more-link">{String(books.length).padStart(2, "0")} books</span>
    </div>
    <div class="book-grid">
      {books.map((b) => (
        <a href={b.url} target="_blank" rel="noopener noreferrer" title="View book">
          <img class="book-cover" src={b.image} alt="Book cover" loading="lazy" />
        </a>
      ))}
    </div>
  </section>

  <section class="page-section">
    <div class="section-head">
      <h2>Favorite resources</h2>
      <span class="more-link">{String(links.length).padStart(2, "0")} categories</span>
    </div>
    {links.map((cat) => (
      <div class="resource-category">
        <h3>{cat.category}</h3>
        <div class="resource-list">
          {cat.links.map((l) => (
            <a class="resource-row" href={l.url} target="_blank" rel="noopener noreferrer">
              <span class="resource-title">{l.title}</span>
              <span class="resource-desc"> — {l.description}</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
</Layout>
