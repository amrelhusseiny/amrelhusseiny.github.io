---
// Standalone CV — Graphite monochrome design, dark mode, A4 printable.
import { cv } from "../lib/cv";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Amro ElHusseini — CV</title>
    <meta name="description" content="Curriculum Vitae — Amro ElHusseini, Senior Private Cloud Engineer (Networks), Frankfurt am Main, Germany." />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      :root {
        --font-mono: "Segoe UI", monospace;
        --text-xs: 12px; --text-base: 16px; --text-md: 21px;
        --space-1: 4px; --space-2: 8px; --space-3: 12px; --space-4: 16px; --space-5: 24px; --space-6: 32px;
        --color-bg: #fff; --color-surface: #f5f5f5; --color-border: #c6c6c6;
        --color-text-primary: #232323; --color-text-secondary: #545454; --color-text-muted: #8A8A8A;
        --color-invert-bg: #232323; --color-invert-text: #fff;
      }
      [data-theme="dark"] {
        --color-bg: #000; --color-surface: #232323; --color-border: #232323;
        --color-text-primary: #f5f5f5; --color-text-secondary: #ececec; --color-text-muted: #8A8A8A;
        --color-invert-bg: #ececec; --color-invert-text: #000;
      }
      html, body {
        width: 100%; background: var(--color-bg); color: var(--color-text-primary);
        font-family: var(--font-mono); -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: underline; text-decoration-color: var(--color-text-muted); }
      a:hover { text-decoration-color: var(--color-text-primary); }
      ul, ol { list-style: none; }
      .page { max-width: 720px; margin: 0 auto; padding: var(--space-8) var(--space-6) var(--space-9); }
      .utility-bar {
        display: flex; justify-content: flex-end; gap: var(--space-3);
        padding: var(--space-4) var(--space-6) 0; max-width: 720px; margin: 0 auto;
      }
      .btn {
        font-family: var(--font-mono); font-size: var(--text-xs);
        letter-spacing: 0.08em; text-transform: uppercase;
        padding: var(--space-2) var(--space-4);
        border: 1px solid var(--color-border);
        background: var(--color-bg); color: var(--color-text-primary);
        border-radius: 0; cursor: pointer;
      }
      .btn:hover { background: var(--color-surface); }
      .btn.invert { background: var(--color-invert-bg); color: var(--color-invert-text); border-color: var(--color-invert-bg); }
      .identity {
        display: flex; flex-direction: column; gap: var(--space-5);
        padding-bottom: var(--space-6); border-bottom: 1px solid var(--color-border); margin-bottom: var(--space-7);
      }
      .identity-name { font-size: var(--text-md); font-weight: bold; }
      .identity-role { font-size: var(--text-base); color: var(--color-text-secondary); margin-top: var(--space-2); }
      .spec-table { width: 100%; border-collapse: collapse; }
      .spec-table td.k::before { content: attr(data-label); }
      .spec-table td { padding: var(--space-2) var(--space-3) var(--space-2) 0; font-size: var(--text-base); vertical-align: top; }
      .spec-table td.k {
        width: 140px; color: var(--color-text-muted); font-size: var(--text-xs);
        letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap;
      }
      .section { margin-bottom: var(--space-8); }
      .section-head {
        display: flex; align-items: baseline; gap: var(--space-4);
        margin-bottom: var(--space-5);
      }
      .section-head .label {
        font-size: var(--text-base); font-weight: bold; letter-spacing: 0.1em;
        text-transform: uppercase; white-space: nowrap; flex-shrink: 0;
      }
      .section-head .rule { flex: 1; height: 0; border-top: 1px solid var(--color-border); transform: translateY(-4px); }
      p.body { font-size: var(--text-base); line-height: 1.5; color: var(--color-text-primary); }
      .entry { display: grid; grid-template-columns: 160px 1fr; gap: var(--space-5); padding: var(--space-5) 0; border-bottom: 1px solid var(--color-border); }
      .entry:last-child { border-bottom: none; }
      .entry-date { font-size: var(--text-xs); color: var(--color-text-muted); letter-spacing: 0.04em; }
      .entry-title { font-size: var(--text-md); font-weight: bold; }
      .entry-org { margin-top: var(--space-1); font-size: var(--text-base); font-weight: bold; color: var(--color-text-secondary); }
      .entry-loc { font-size: var(--text-xs); color: var(--color-text-muted); letter-spacing: 0.04em; }
      .entry-body { margin-top: var(--space-3); }
      ul.bullets { margin-top: var(--space-2); display: flex; flex-direction: column; gap: var(--space-2); }
      ul.bullets li { font-size: var(--text-base); line-height: 1.5; padding-left: var(--space-4); position: relative; }
      ul.bullets li::before { content: "—"; position: absolute; left: 0; color: var(--color-text-muted); }
      .project { padding: var(--space-4) 0; border-bottom: 1px solid var(--color-border); }
      .project:last-child { border-bottom: none; }
      .project-title { font-size: var(--text-md); font-weight: bold; margin-bottom: var(--space-2); }
      .doc-footer {
        margin-top: var(--space-9); padding-top: var(--space-4); border-top: 1px solid var(--color-border);
        font-size: var(--text-xs); color: var(--color-text-muted); display: flex; justify-content: space-between;
      }
      @media screen and (max-width: 640px) {
        .entry { grid-template-columns: 1fr; gap: var(--space-2); }
        .spec-table td.k { width: 96px; }
        .page { padding: var(--space-4); }
      }
      @media print {
        @page { size: A4; margin: 12mm; }
        html, body, [data-theme="dark"] {
          --color-bg: #fff; --color-surface: #f5f5f5; --color-border: #c6c6c6;
          --color-text-primary: #232323; --color-text-secondary: #545454; --color-text-muted: #8A8A8A;
        }
        .utility-bar { display: none; }
        .page { padding: 0; max-width: none; }
        .entry { break-inside: avoid; }
        .entry-title, .entry-org, .entry-loc { break-after: avoid; }
        p.body, li { orphans: 3; widows: 3; }
        -webkit-print-color-adjust: exact; print-color-adjust: exact;
      }
    </style>
  </head>
  <body>
    <div class="utility-bar">
      <button class="btn" id="theme-toggle" type="button">Dark mode</button>
      <button class="btn invert" id="print-btn" type="button">Print / Save PDF</button>
    </div>

    <main class="page">
      <header class="identity">
        <h1 class="identity-name">Amro ElHusseini</h1>
        <p class="identity-role">Senior Private Cloud Engineer (Networks)</p>

        <table class="spec-table">
          <tr>
            <td class="k" data-label="Home"></td>
            <td>{cv.location}</td>
          </tr>
          <tr>
            <td class="k" data-label="Email"></td>
            <td><a href="mailto:{cv.email}">{cv.email}</a></td>
          </tr>
          <tr>
            <td class="k" data-label="Phone"></td>
            <td><a href="tel:{cv.phone}">{cv.phone}</a> &nbsp;·&nbsp; WhatsApp: {cv.whatsapp}</td>
          </tr>
          <tr>
            <td class="k" data-label="Website"></td>
            <td><a href="https://amroelhusseini.vercel.app/" target="_blank" rel="noopener">amroelhusseini.vercel.app</a></td>
          </tr>
          <tr>
            <td class="k" data-label="LinkedIn"></td>
            <td><a href="https://www.linkedin.com/in/A.Elhusseini" target="_blank" rel="noopener">A.Elhusseini</a></td>
          </tr>
          <tr>
            <td class="k" data-label="Permits"></td>
            <td>Residence: Niederlassungserlaubnis — YZ7M3MK5V &nbsp;·&nbsp; Work permit: German</td>
          </tr>
          <tr>
            <td class="k" data-label="Nationality"></td>
            <td>Egyptian</td>
          </tr>
        </table>
      </header>

      <section class="section">
        <div class="section-head"><h2 class="label">About Me</h2><span class="rule"></span></div>

        <p class="body">What I can offer,</p>

        <ol style="counter-reset: num; display: flex; flex-direction: column; gap: var(--space-4); margin: var(--space-4) 0;">
          <li style="display: flex; gap: var(--space-4); counter-increment: num;">
            <span style="flex-shrink: 0; width: var(--space-5); height: var(--space-5); border: 1px solid var(--color-border); display: flex; align-items: center; justify-content: center; font-size: var(--text-xs); font-weight: bold;">1</span>
            <div style="font-size: var(--text-base); line-height: 1.5;">Even though my company is still moving through legacy workflow, I have already adapted Agentic Workflows, implemented LangChain and N8N deployments, and run agents to manage our ticketing system and RAG over my Confluence and email knowledge for semantic search.</div>
          </li>
          <li style="display: flex; gap: var(--space-4); counter-increment: num;">
            <span style="flex-shrink: 0; width: var(--space-5); height: var(--space-5); border: 1px solid var(--color-border); display: flex; align-items: center; justify-content: center; font-size: var(--text-xs); font-weight: bold;">2</span>
            <div style="font-size: var(--text-base); line-height: 1.5;">My experience spans a wide range of network specialties — from IP backbone hosting converged IMS/mobile backhaul (Egypt Telecom), enterprise service provider VPN/MPLS routing and tunneling for global sites (Orange Business Services), cloud backend on OpenStack-based public cloud in Europe (Flexible Engine / Huawei CloudStack), to my previous role in customer-end enterprise networks managing Wifi, firewalls and VPNs across datacenter and office sites (Hyundai Autoever Europe GmbH). I have now moved to the OpenStack deployment, managing the data center and virtual OpenStack layers.</div>
          </li>
        </ol>

        <p class="body">In addition, working in a very process-oriented environment at Orange Business Services taught me how to establish process and apply best practices — from change management and project implementation to documentation of daily work.</p>
      </section>

      <section class="section">
        <div class="section-head"><h2 class="label">Technical Expertise</h2><span class="rule"></span></div>
        <h3 style="font-size: var(--text-base); font-weight: bold; margin-bottom: var(--space-4);">Hands-on skills acquired across my career</h3>

        <ul style="display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3);">
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base);">LangChain, N8N, Pi, MCP — agentic code workflows</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base);">IP Routing (BGP, MP-BGP, MPLS, OSPF), Switching</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base);">Docker, Grafana, Telegraf, InfluxDB</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base);">Terraform</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base);">Python</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base);">Python Flask</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base);">OpenStack Neutron</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base);">Linux Administration</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base);">Cisco ISE 2.6 & 3.1</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base);">Cisco WLC (9800 & 5500)</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base);">Cisco Catalyst / Nexus 9k</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base);">Palo Alto 10.x & 11.x Firewalls</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base);">Cisco ASA Firewalls</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base);">Juniper MX, PTX Backbone Routers</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base);">Juniper SRX Firewalls</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base);">Huawei Cloud Stack</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base);">SolarWinds NPM</li>
        </ul>
      </section>

      <section class="section">
        <div class="section-head"><h2 class="label">Work Experience</h2><span class="rule"></span></div>

        <div class="entry">
          <div class="entry-date"><time datetime="2026-06-01">01/06/2026</time> — Current</div>
          <div>
            <h3 class="entry-title">Senior Private Cloud Engineer (Networks)</h3>
            <p class="entry-org">Hyundai Autoever Europe GmbH</p>
            <div class="entry-loc">Frankfurt am Main, Germany</div>
            <div class="entry-body">
              <p class="body">Managing the network layer of an Arista-based datacenter hosting a vanilla OpenStack deployment. Responsible for underlay/overlay design and operations on Arista switches and the OpenStack Neutron layer. Developing automation scripts and AI-driven tools to optimize day-to-day operations.</p>
            </div>
          </div>
        </div>

        <div class="entry">
          <div class="entry-date"><time datetime="2023-07">07/2023</time> — <time datetime="2026-05">05/2026</time></div>
          <div>
            <h3 class="entry-title">Network Systems Engineer</h3>
            <p class="entry-org">Hyundai Autoever GmbH</p>
            <div class="entry-loc">Offenbach, Germany</div>
            <div class="entry-body">
              <p class="body">Implementation and management of datacenter and enterprise network infrastructure across multiple customers, acting as project manager for new implementations.</p>
              <ul class="bullets">
                <li>Cisco ISE 2.x & 3.x (NAC)</li>
                <li>Cisco WLC 9800 & 5500 (Wi-Fi)</li>
                <li>Cisco Nexus / Catalyst 9K</li>
                <li>Cisco ASA & Palo Alto firewalls</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="entry">
          <div class="entry-date"><time datetime="2021-08">08/2021</time> — <time datetime="2022-10">10/2022</time></div>
          <div>
            <h3 class="entry-title">Public Cloud Operations Engineer — Network Domain</h3>
            <p class="entry-org">Orange Business Services</p>
            <div class="entry-loc">Cairo, Egypt</div>
            <div class="entry-body">
              <p class="body">Worked on both physical and virtual network layers of cloud datacenter infrastructure. Managed capacity, peering with Orange backbone, and virtual network appliances.</p>
              <ul class="bullets">
                <li>Physical DC network (CLOS design)</li>
                <li>Virtual networks: OpenStack, VLAN, VXLAN</li>
                <li>Security appliances: VPN gateways, Anti-DDoS, WAF</li>
                <li>Terraform (first use)</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="entry">
          <div class="entry-date"><time datetime="2019-06">06/2019</time> — <time datetime="2021-07">07/2021</time></div>
          <div>
            <h3 class="entry-title">IP Core Planning Senior Engineer</h3>
            <p class="entry-org">TE Data (Telecom Egypt) / WE</p>
            <div class="entry-loc">Cairo, Egypt</div>
            <div class="entry-body">
              <p class="body">Responsible for backbone planning, migration, and automation across a converged national backbone network supporting Fixed, Mobile, and Broadband services.</p>
              <ul class="bullets">
                <li>BGP, MPLS & OSPF — deep operational expertise</li>
                <li>Migration of P/PE/RR/BNG devices (Cisco, Juniper, Nokia)</li>
                <li>Multi-vendor software upgrades</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="entry">
          <div class="entry-date"><time datetime="2018-06">06/2018</time> — <time datetime="2019-06">06/2019</time></div>
          <div>
            <h3 class="entry-title">VPN Implementation Engineer — Level 3</h3>
            <p class="entry-org">Orange Business Services</p>
            <div class="entry-loc">Cairo, Egypt</div>
            <div class="entry-body">
              <p class="body">Supporting global enterprise customers across multiple continents on a vast international MPLS/VPN network. Managing HUB sites and working with optimization technologies.</p>
            </div>
          </div>
        </div>

        <div class="entry">
          <div class="entry-date"><time datetime="2016-10">10/2016</time> — <time datetime="2018-06">06/2018</time></div>
          <div>
            <h3 class="entry-title">Incident Management Specialist — 1st Line Engineer</h3>
            <p class="entry-org">Orange Business Services</p>
            <div class="entry-loc">Cairo, Egypt</div>
            <div class="entry-body">
              <p class="body">First-line incident management for global enterprise customers, providing troubleshooting and customer support during service instability.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-head"><h2 class="label">Language Skills</h2><span class="rule"></span></div>
        <ul class="bullets">
          <li>English — C2 (proficient user)</li>
          <li>German — A1 (basic user)</li>
        </ul>
      </section>

      <section class="section">
        <div class="section-head"><h2 class="label">Education and Training</h2><span class="rule"></span></div>
        <div class="entry">
          <div class="entry-date"><time datetime="2008-06">06/2008</time> — <time datetime="2013-11">11/2013</time></div>
          <div>
            <h3 class="entry-title">Bachelor's Degree, Computer Engineering</h3>
            <p class="entry-org">Arab Academy for Science and Technology and Maritime (AASTMT)</p>
            <div style="font-size: var(--text-xs); color: var(--color-text-muted); margin-top: var(--space-2);">
              <a href="https://www.aast.edu/" target="_blank" rel="noopener">https://www.aast.edu/</a><br>
              Cairo, Egypt — Grade: 2.56
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-head"><h2 class="label">Driving Licence</h2><span class="rule"></span></div>
        <div style="font-size: var(--text-base);">
          Category: B (since <time datetime="2025-02-18">18/02/2025</time>)
        </div>
      </section>

      <section class="section">
        <div class="section-head"><h2 class="label">Projects</h2><span class="rule"></span></div>

        <div class="project">
          <h3 class="project-title">MCP Servers</h3>
          <p class="body">Developed private and public MCP servers for AI-driven automation of network operations, covering Palo Alto, Cisco, Outlook, and ServiceNow. Deployed using N8N for workflow automation.</p>
        </div>

        <div class="project">
          <h3 class="project-title">Physical Network Auditing Tool</h3>
          <p class="body">Multithreaded Python script to audit network device configurations across hundreds of devices in parallel. Reduced a 4-hour manual audit to under 2 minutes.</p>
        </div>

        <div class="project">
          <h3 class="project-title">Network Topology Plotter</h3>
          <p class="body">Automated network topology generation by parsing device configurations. Used at both Orange Business Services and TE Data.</p>
          <div style="margin-top: var(--space-2); font-size: var(--text-xs);"><a class="invert" style="background: var(--color-invert-bg); color: var(--color-invert-text); padding: 0 var(--space-2); text-decoration: none;" href="https://github.com/amrelhusseiny/drawio_network_plot" target="_blank" rel="noopener">github.com/amrelhusseiny/drawio_network_plot</a></div>
        </div>
      </section>

      <footer class="doc-footer">
        <span>Amro ElHusseini — Curriculum Vitae</span>
        <span id="footer-date"></span>
      </footer>
    </main>

    <script>
      (function () {
        var root = document.documentElement;
        document.getElementById('footer-date').textContent = new Date().toISOString().slice(0, 10);
        document.getElementById('theme-toggle').addEventListener('click', function () {
          var isDark = root.getAttribute('data-theme') === 'dark';
          if (isDark) root.removeAttribute('data-theme'); else root.setAttribute('data-theme', 'dark');
        });
        document.getElementById('print-btn').addEventListener('click', function () { window.print(); });
      })();
    </script>
  </body>
</html>
