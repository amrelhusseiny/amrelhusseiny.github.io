      <section class="section">
        <div class="section-head"><h2 class="label">About Me</h2><span class="rule"></span></div>

        <p class="body">What I can offer,</p>

        <ol style="counter-reset: num; display: flex; flex-direction: column; gap: var(--space-3); margin: var(--space-4) 0;">
          <li style="display: flex; gap: var(--space-3); counter-increment: num;">
