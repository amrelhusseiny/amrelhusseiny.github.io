<style>
/* ==========================================================
   CV stylesheet — matched to the reference CV (Letter-style
   layout: Noto Sans body, grey boxed section headings,
   bold caps employer + right-aligned dates).
   Edit the variables below to restyle everything.
   ========================================================== */

@font-face {
  font-family: "Noto Sans";
  src: url("/fonts/NotoSans-VF.ttf") format("truetype");
  font-weight: 100 900; font-style: normal;
}
@font-face {
  font-family: "Noto Sans";
  src: url("/fonts/NotoSans-Italic-VF.ttf") format("truetype");
  font-weight: 100 900; font-style: italic;
}

:root {
  --sans:  "Noto Sans", "Open Sans", Arial, sans-serif;
  --serif: "Liberation Serif", "Times New Roman", Times, serif;
  --body-size: 11pt;          /* body text                      */
  --summary-size: 15pt;       /* large centred lines            */
  --name-size: 14pt;
  --heading-size: 10pt;       /* text inside the grey boxes     */
  --small-size: 8.5pt;        /* small serif lines in header    */
  --box-bg: #808080;          /* grey section heading box       */
  --box-border: #000;
  --link: #0000ee;
  --margin-x: 0.5in;
  --margin-top: 0.55in;
  --margin-bottom: 0.5in;
}

/* Change A4 -> Letter here if you prefer the reference page size */
@page { size: Letter; margin: var(--margin-top) var(--margin-x) var(--margin-bottom); }

* { box-sizing: border-box; }
html { background: #cfcfcf; }
body {
  font-family: var(--sans);
  font-size: var(--body-size);
  line-height: 1.362;             /* Noto Sans "normal" line height */
  color: #000;
  margin: 0;
  -webkit-print-color-adjust: exact; print-color-adjust: exact;
}

/* sheet on screen */
.page {
  width: 8.5in; min-height: 11in;
  margin: 10mm auto;
  padding: var(--margin-top) var(--margin-x) var(--margin-bottom);
  background: #fff;
  box-shadow: 0 0 6px rgba(0,0,0,.3);
}
@media print {
  html { background: none; }
  .page { width: auto; min-height: 0; margin: 0; padding: 0; box-shadow: none; }
}

p { margin: 0; }
p + p { margin-top: 6pt; }
a { color: var(--link); text-decoration: underline; }

/* ---------- Header (centred) ---------- */
header { text-align: center; }
header h1 { font-size: var(--name-size); font-weight: 700; margin: 0; line-height: 1.362; }
header .role { font-size: 12pt; margin: 0; }
header .email { font-size: 12pt; margin: 0; }
header .small {
  font-family: var(--serif); font-size: var(--small-size);
  line-height: 1.15; margin: 0;
}
header p + p { margin-top: 0; }

/* ---------- Section heading boxes ---------- */
h2 {
  font-size: var(--heading-size);
  font-weight: 700;
  text-transform: uppercase;
  text-align: center;
  line-height: 1.25;
  margin: 14pt 0 18pt;
  padding: 1.5pt 4pt;
  background: var(--box-bg);
  border: 1.2px solid var(--box-border);
  break-after: avoid;
}
/* content sits slightly inside the box edges (table-cell padding) */
.in { padding: 0 5pt; }

.subtitle { font-style: italic; margin: 0 0 6pt; }
.num { font-weight: 700; margin-top: 6pt; }
.num + p { margin-top: 0; }

/* centred statement lines (used by About Me heading text if wanted) */
.centered { text-align: center; font-size: var(--summary-size); line-height: 1.362; }

/* ---------- Entries ---------- */
.entry { margin-top: 30pt; orphans: 3; widows: 3; }
h2 + .in > .entry:first-child { margin-top: 0; padding-top: 21pt; }
.entry-head {
  display: flex; justify-content: space-between; align-items: baseline;
  gap: 12pt; break-after: avoid;
}
.org { font-weight: 700; text-transform: uppercase; }
.loc { font-weight: 400; text-transform: none; }
.dates { white-space: nowrap; font-weight: 400; }
.job-title { font-weight: 700; font-style: italic; break-after: avoid; }
h4 { font-size: var(--body-size); font-weight: 700; margin: 6pt 0 0; break-after: avoid; }

/* ---------- Bullets (square) ---------- */
ul { list-style: none; margin: 0; padding-left: 18pt; }
ul > li { position: relative; margin-top: 2pt; }
ul > li::before { content: "\25AA"; position: absolute; left: -14pt; }
ul ul { padding-left: 16pt; }
ul ul > li::before { content: "\2013"; }

/* ---------- Projects ---------- */
.project { margin-top: 14pt; break-inside: avoid; }
.project:first-child { margin-top: 0; }
.project h4 { margin-top: 0; }

footer {
  margin-top: 20pt; text-align: center; font-style: italic;
  font-size: 8.5pt; color: #555;
}

/* ==========================================================
   ADDITIONS — support pieces for this page only.
   The document rules above are unchanged from style.css.
   ========================================================== */

/* ---------- QR codes in the header ---------- */
img.qr {
  width: 24mm; height: 24mm;
  margin: 6pt 5pt 2pt;
  image-rendering: -webkit-optimize-contrast;
  vertical-align: top;
}

/* ---------- Screen chrome: language + theme, never printed ---------- */
.cv-utility {
  display: flex; justify-content: center; align-items: center;
  gap: 8px; padding: 12px 12px 0;
  font-family: var(--sans);
}
.cv-utility button {
  font-family: var(--sans); font-size: 10pt; line-height: 1.2;
  padding: 5px 13px;
  border: 1px solid #6d6d6d;
  background: transparent; color: inherit;
  cursor: pointer;
}
.cv-utility button:hover { background: rgba(128,128,128,.22); }
.cv-utility button[aria-pressed="true"] {
  background: #333; color: #fff; border-color: #333;
}
.cv-utility .spacer { width: 10px; }

/* ---------- Bilingual switch: one tree visible at a time ---------- */
.lang-de { display: none; }
html[data-lang="de"] .lang-en { display: none; }
html[data-lang="de"] .lang-de { display: block; }

/* ---------- Dark theme ----------
   Select the root as html[data-theme=...], never [data-theme=...] html —
   the latter is a descendant selector and can never match <html>. */
html[data-theme="dark"] {
  --box-bg: #343434;
  --box-border: #d9d9d9;
  --link: #8ab4ff;
  background: #0c0c0c;
}
html[data-theme="dark"] body { color: #e8e8e8; }
html[data-theme="dark"] .page { background: #151515; box-shadow: 0 0 6px rgba(0,0,0,.65); }
html[data-theme="dark"] .cv-utility button[aria-pressed="true"] {
  background: #e2e2e2; color: #111; border-color: #e2e2e2;
}

/* ---------- Print: always the light document ---------- */
@media print {
  .cv-utility { display: none; }
  html[data-theme="dark"] {
    --box-bg: #808080; --box-border: #000; --link: #0000ee;
  }
  html[data-theme="dark"] body { background: #fff; color: #000; }
  html[data-theme="dark"] .page { background: #fff; color: #000; }
}
</style>
</head>
<body>

<div class="cv-utility">
  <button class="lang-btn" data-lang="en" type="button" aria-pressed="true">English</button>
  <button class="lang-btn" data-lang="de" type="button" aria-pressed="false">Deutsch</button>
  <span class="spacer"></span>
  <button id="theme-toggle" type="button">Dark mode</button>
  <button id="print-btn" type="button">Print / Save PDF</button>
</div>

