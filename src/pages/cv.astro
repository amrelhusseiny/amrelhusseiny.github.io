<script>
  (function () {
    var root = document.documentElement;
    var langBtns = document.querySelectorAll('.lang-btn');
    var themeBtn = document.getElementById('theme-toggle');

    function syncThemeLabel() {
      var dark = root.getAttribute('data-theme') === 'dark';
      var de = root.getAttribute('data-lang') === 'de';
      themeBtn.textContent = dark
        ? (de ? 'Hellmodus' : 'Light mode')
        : (de ? 'Dunkelmodus' : 'Dark mode');
    }

    function setLang(lang) {
      root.setAttribute('data-lang', lang);
      root.setAttribute('lang', lang);
      document.title = lang === 'de' ? 'Amro ElHusseini — Lebenslauf' : 'Amro ElHusseini';
      langBtns.forEach(function (b) {
        b.setAttribute('aria-pressed', String(b.getAttribute('data-lang') === lang));
      });
      try { localStorage.setItem('cv-lang', lang); } catch (e) {}
      syncThemeLabel();
    }

    langBtns.forEach(function (b) {
      b.addEventListener('click', function () { setLang(b.getAttribute('data-lang')); });
    });

    setLang(root.getAttribute('data-lang') === 'de' ? 'de' : 'en');

    themeBtn.addEventListener('click', function () {
      var dark = root.getAttribute('data-theme') === 'dark';
      if (dark) root.removeAttribute('data-theme');
      else root.setAttribute('data-theme', 'dark');
      try { localStorage.setItem('cv-theme', dark ? 'light' : 'dark'); } catch (e) {}
      syncThemeLabel();
    });

    syncThemeLabel();

    document.getElementById('print-btn').addEventListener('click', function () { window.print(); });
  })();
</script>

