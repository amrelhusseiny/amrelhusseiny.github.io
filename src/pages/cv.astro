---
// Standalone CV — Graphite monochrome design, bilingual (EN/DE), dark mode, A4 printable.
import { cv } from "../lib/cv";

// Bilingual labels
const labels = {
  en: {
    about: "About Me",
    skills: "Technical Expertise",
    experience: "Work Experience",
    skills: "Language Skills",
    education: "Education and Training",
    driving: "Driving Licence",
    projects: "Projects",
    role: "Senior Private Cloud Engineer (Networks)",
    footer: "Amro ElHusseini — Curriculum Vitae"
  },
  de: {
    about: "Über mich",
    skills: "Technische Expertise",
    experience: "Berufserfahrung",
    skills: "Sprachkenntnisse",
    education: "Ausbildung",
    driving: "Führerschein",
    projects: "Projekte",
    role: "Senior Private Cloud Engineer (Netzwerke)",
    footer: "Amro ElHusseini — Lebenslauf"
  }
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Amro ElHusseini — CV</title>
    <meta name="description" content="Curriculum Vitae — Amro ElHusseini, Senior Private Cloud Engineer (Networks), Frankfurt am Main, Germany." />
    <meta name="author" content="Amro ElHusseini" />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      :root {
        --font-mono: "Segoe UI", monospace;
        --text-xs: 12px; --text-base: 16px; --text-md: 21px; --text-lg: 28px; --text-xl: 38px;
        --space-1: 4px; --space-2: 8px; --space-3: 12px; --space-4: 16px; --space-5: 24px; --space-6: 32px;
        --color-bg: #fff; --color-surface: #f5f5f5; --color-border: #c6c6c6;
        --color-text-primary: #232323; --color-text-secondary: #545454; --color-text-muted: #8A8A8A;
        --color-invert-bg: #232323; --color-invert-text: #fff;
      }
      [data-theme="dark"] {
        --color-bg: #000; --color-surface: #232323; --color-border: #232323;
        --color-text-primary: #f5f5f5; --color-text-secondary: #ececec; --color-text-muted: #8A8A8A;
        --color-invert-bg: #ececec; --color-invert-text: #000;
      }
      html, body {
        width: 100%; background: var(--color-bg); color: var(--color-text-primary);
        font-family: var(--font-mono); -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: underline; text-decoration-color: var(--color-text-muted); }
      a:hover { text-decoration-color: var(--color-text-primary); }
      ul, ol { list-style: none; }
      .page { max-width: 720px; margin: 0 auto; padding: var(--space-8) var(--space-6) var(--space-9); }
      .utility-bar {
        display: flex; justify-content: flex-end; gap: var(--space-3);
        padding: var(--space-4) var(--space-6) 0; max-width: 720px; margin: 0 auto;
      }
      .btn {
        font-family: var(--font-mono); font-size: var(--text-xs);
        letter-spacing: 0.08em; text-transform: uppercase;
        padding: var(--space-2) var(--space-4);
        border: 1px solid var(--color-border);
        background: var(--color-bg); color: var(--color-text-primary);
        border-radius: 0; cursor: pointer;
      }
      .btn:hover { background: var(--color-surface); }
      .btn.invert { background: var(--color-invert-bg); color: var(--color-invert-text); border-color: var(--color-invert-bg); }
      .identity {
        display: flex; flex-direction: column; gap: var(--space-5);
        padding-bottom: var(--space-6); border-bottom: 1px solid var(--color-border); margin-bottom: var(--space-7);
      }
      .identity-name { font-size: var(--text-xl); font-weight: bold; letter-spacing: -0.01em; line-height: 1.15; }
      .identity-role { font-size: var(--text-md); color: var(--color-text-secondary); margin-top: var(--space-1); }
      .spec-table { width: 100%; border-collapse: collapse; }
      .spec-table td.k::before { content: attr(data-label); }
      .spec-table td { padding: var(--space-2) var(--space-3) var(--space-2) 0; font-size: var(--text-base); vertical-align: top; }
      .spec-table td.k {
        width: 140px; color: var(--color-text-muted); font-size: var(--text-xs);
        letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; padding-top: var(--space-3);
      }
      .section { margin-bottom: var(--space-8); }
      .section-head {
        display: flex; align-items: baseline; gap: var(--space-4);
        margin-bottom: var(--space-5);
      }
      .section-head .label {
        font-size: var(--text-base); font-weight: bold; letter-spacing: 0.1em;
        text-transform: uppercase; white-space: nowrap; flex-shrink: 0;
      }
      .section-head .rule { flex: 1; height: 0; border-top: 1px solid var(--color-border); transform: translateY(-4px); }
      p.body { font-size: var(--text-base); line-height: 1.5; color: var(--color-text-primary); }
      .entry { display: grid; grid-template-columns: 160px 1fr; gap: var(--space-5); padding: var(--space-5) 0; border-bottom: 1px solid var(--color-border); }
      .entry:last-child { border-bottom: none; }
      .entry-date { font-size: var(--text-xs); color: var(--color-text-muted); letter-spacing: 0.04em; padding-top: var(--space-1); }
      .entry-title { font-size: var(--text-md); font-weight: bold; line-height: 1.15; }
      .entry-org { margin-top: var(--space-1); font-size: var(--text-base); font-weight: bold; color: var(--color-text-secondary); }
      .entry-loc { font-size: var(--text-xs); color: var(--color-text-muted); letter-spacing: 0.04em; }
      .entry-body { margin-top: var(--space-3); }
      .entry-body p.body { margin-top: var(--space-3); }
      .entry-body p.body:first-child { margin-top: 0; }
      ul.bullets { margin-top: var(--space-2); display: flex; flex-direction: column; gap: var(--space-2); }
      ul.bullets li { font-size: var(--text-base); line-height: 1.5; padding-left: var(--space-4); position: relative; }
      ul.bullets li::before { content: "—"; position: absolute; left: 0; color: var(--color-text-muted); }
      .project { padding: var(--space-4) 0; border-bottom: 1px solid var(--color-border); }
      .project:last-child { border-bottom: none; }
      .project-title { font-size: var(--text-md); font-weight: bold; margin-bottom: var(--space-2); }
      .doc-footer {
        margin-top: var(--space-9); padding-top: var(--space-4); border-top: 1px solid var(--color-border);
        font-size: var(--text-xs); color: var(--color-text-muted); display: flex; justify-content: space-between;
      }
      @media screen and (max-width: 640px) {
        .entry { grid-template-columns: 1fr; gap: var(--space-2); }
        .entry-date { border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-2); margin-bottom: var(--space-2); }
        .spec-table td.k { width: 96px; }
        .identity-name { font-size: var(--text-lg); }
      }
      @media print {
        @page { size: A4; margin: 12mm; }
        html, body, [data-theme="dark"] {
          --color-bg: #fff; --color-surface: #f5f5f5; --color-border: #c6c6c6;
          --color-text-primary: #232323; --color-text-secondary: #545454; --color-text-muted: #8A8A8A;
        }
        .utility-bar { display: none; }
        .page { padding: 0; max-width: none; }
        .entry { break-inside: avoid; }
        .entry-title, .entry-org, .entry-loc { break-after: avoid; }
        p.body, li { orphans: 3; widows: 3; }
        -webkit-print-color-adjust: exact; print-color-adjust: exact;
      }
    </style>
  </head>
  <body>
    <div class="utility-bar">
      <button class="btn lang-btn active" data-lang="en" type="button">English</button>
      <button class="btn lang-btn" data-lang="de" type="button">Deutsch</button>
      <button class="btn" id="theme-toggle" type="button">Dark mode</button>
      <button class="btn invert" id="print-btn" type="button">Print / Save PDF</button>
    </div>

    <main class="page">
      <header class="identity">
        <h1 class="identity-name">Amro ElHusseini</h1>
        <p class="identity-role">{cv.role}</p>

        <table class="spec-table">
          <tr>
            <td class="k" data-label="Home"></td>
            <td>{cv.location}</td>
          </tr>
          <tr>
            <td class="k" data-label="Email"></td>
            <td><a href="mailto:{cv.email}">{cv.email}</a></td>
          </tr>
          <tr>
            <td class="k" data-label="Phone"></td>
            <td><a href="tel:{cv.phone}">{cv.phone}</a> &nbsp;·&nbsp; WhatsApp: {cv.whatsapp}</td>
          </tr>
          <tr>
            <td class="k" data-label="Website"></td>
            <td><a href="https://amroelhusseini.vercel.app/" target="_blank" rel="noopener">amroelhusseini.vercel.app</a></td>
          </tr>
          <tr>
            <td class="k" data-label="LinkedIn"></td>
            <td><a href="https://www.linkedin.com/in/A.Elhusseini" target="_blank" rel="noopener">A.Elhusseini</a></td>
          </tr>
          <tr>
            <td class="k" data-label="Permits"></td>
            <td>Residence: Niederlassungserlaubnis — YZ7M3MK5V &nbsp;·&nbsp; Work permit: German</td>
          </tr>
          <tr>
            <td class="k" data-label="Personal"></td>
            <td>Born <time datetime="1991-12-01">01/12/1991</time> &nbsp;·&nbsp; Nationality: Egyptian</td>
          </tr>
        </table>
      </header>

      <section class="section">
        <div class="section-head"><h2 class="label">About Me</h2><span class="rule"></span></div>

        <p class="body">What I can offer,</p>

        <ol style="counter-reset: num; display: flex; flex-direction: column; gap: var(--space-4); margin: var(--space-4) 0;">
          <li style="display: flex; gap: var(--space-4); counter-increment: num;">
            <span style="flex-shrink: 0; width: var(--space-6); height: var(--space-6); border: 1px solid var(--color-border); display: flex; align-items: center; justify-content: center; font-size: var(--text-xs); font-weight: bold;">1</span>
            <div style="font-size: var(--text-base); line-height: 1.5;">Even though my company is still moving through legacy workflow, I have already adapted Agentic Workflows, implemented LangChain and N8N deployments, and run agents to manage our ticketing system and RAG over my Confluence and email knowledge for semantic search.</div>
          </li>
          <li style="display: flex; gap: var(--space-4); counter-increment: num;">
            <span style="flex-shrink: 0; width: var(--space-6); height: var(--space-6); border: 1px solid var(--color-border); display: flex; align-items: center; justify-content: center; font-size: var(--text-xs); font-weight: bold;">2</span>
            <div style="font-size: var(--text-base); line-height: 1.5;">My experience spans a wide range of network specialties — from IP backbone hosting converged IMS/mobile backhaul (Egypt Telecom), enterprise service provider VPN/MPLS routing and tunneling for global sites (Orange Business Services), cloud backend on OpenStack-based public cloud in Europe (Flexible Engine / Huawei CloudStack), to my previous role in customer-end enterprise networks managing Wifi, firewalls and VPNs across datacenter and office sites (Hyundai Autoever Europe GmbH). I have now moved to the OpenStack deployment, managing the data center and virtual OpenStack layers.</div>
          </li>
        </ol>

        <p class="body">In addition, working in a very process-oriented environment at Orange Business Services taught me how to establish process and apply best practices — from change management and project implementation to documentation of daily work.</p>
      </section>

      <section class="section">
        <div class="section-head"><h2 class="label">Technical Expertise</h2><span class="rule"></span></div>
        <h3 style="font-size: var(--text-md); font-weight: bold; margin-bottom: var(--space-4);">Hands-on skills acquired across my career</h3>

        <ul style="display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3);">
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base); line-height: 1.4;">LangChain, N8N, Pi, MCP — agentic code workflows</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base); line-height: 1.4;">IP Routing (BGP, MP-BGP, MPLS, OSPF), Switching</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base); line-height: 1.4;">Docker, Grafana, Telegraf, InfluxDB <span style="color: var(--color-text-secondary);">(self-taught)</span></li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base); line-height: 1.4;">Terraform <span style="color: var(--color-text-secondary);">(Orange Flexible Engine)</span></li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base); line-height: 1.4;">Python <span style="color: var(--color-text-secondary);">(automation of network + OpenStack)</span></li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base); line-height: 1.4;">Python Flask + HTML / CSS / Bootstrap <span style="color: var(--color-text-secondary);">(self-taught)</span></li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base); line-height: 1.4;">OpenStack Neutron <span style="color: var(--color-text-secondary);">(Orange Flexible Engine, Huawei Cloud Stack)</span></li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base); line-height: 1.4;">Linux Administration</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base); line-height: 1.4;">Cisco ISE 2.6 & 3.1</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base); line-height: 1.4;">Cisco WLC (9800 & 5500)</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base); line-height: 1.4;">Cisco Catalyst / Nexus 9k</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base); line-height: 1.4;">Palo Alto 10.x & 11.x Firewalls / GlobalProtect VPN</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base); line-height: 1.4;">Cisco ASA Firewalls & SSL VPN</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base); line-height: 1.4;">Juniper MX, PTX Backbone Routers</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base); line-height: 1.4;">Juniper SRX Firewalls</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base); line-height: 1.4;">NOKIA Routers — ADSL Termination</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base); line-height: 1.4;">Huawei Cloud Stack — Networks / Neutron</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base); line-height: 1.4;">SolarWinds NPM, NTA Administration</li>
          <li style="border: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); font-size: var(--text-base); line-height: 1.4;">Cisco ASR 9k Backbone Routers — full OSPF converged Egypt backbone</li>
        </ul>
      </section>

      <section class="section">
        <div class="section-head"><h2 class="label">Work Experience</h2><span class="rule"></span></div>

        <div class="entry">
          <div class="entry-date"><time datetime="2026-06-01">01/06/2026</time> — Current</div>
          <div>
            <h3 class="entry-title">Senior Private Cloud Engineer (Networks)</h3>
            <p class="entry-org">Hyundai Autoever Europe GmbH</p>
            <div class="entry-loc">Frankfurt am Main, Germany</div>
            <div class="entry-body">
              <p class="body">I work with an Arista data center hosting an OpenStack vanilla deployment, managing the network between the data center, underlay/overlay on Arista switches, and the OpenStack Neutron layer. It's an operational role in which I develop scripts, automation, and AI-driven automations for optimizing day-to-day operations.</p>
              <p class="body">Vendors: Arista, OpenStack.</p>
            </div>
          </div>
        </div>

        <div class="entry">
          <div class="entry-date"><time datetime="2023-07">07/2023</time> — Current</div>
          <div>
            <h3 class="entry-title">Network Systems Engineer</h3>
            <p class="entry-org">Hyundai Autoever GmbH</p>
            <div class="entry-loc">Offenbach, Germany</div>
            <div class="entry-body">
              <p class="body">Implementation and management of datacenter and enterprise infrastructure, including:</p>
              <ul class="bullets">
                <li>Cisco ISE (2.x & 3.x)</li>
                <li>Cisco Nexus (legacy & 9K)</li>
                <li>Cisco WLC (9800 & 5500)</li>
                <li>Cisco IOS-based devices (legacy and Catalyst 9k)</li>
                <li>Cisco ASA & Palo Alto firewalls (filtering, SSL & IPSec)</li>
                <li>Cisco DNA Center</li>
              </ul>
              <p class="body">Managing multiple customers with multiple infrastructure needs, also acting as project manager for new implementations.</p>
            </div>
          </div>
        </div>

        <div class="entry">
          <div class="entry-date"><time datetime="2023-03">03/2023</time> — <time datetime="2023-06">06/2023</time></div>
          <div>
            <h3 class="entry-title">Cloud Systems Engineer</h3>
            <p class="entry-org">G42 Cloud</p>
            <div class="entry-loc">Abu Dhabi, United Arab Emirates</div>
            <div class="entry-body">
              <p class="body">Maintained Huawei Cloud Stack (OpenStack-based) cloud, mainly managing the Neutron infrastructure — continuing the same track from Ericsson and Orange Business Services.</p>
            </div>
          </div>
        </div>

        <div class="entry">
          <div class="entry-date"><time datetime="2022-11">11/2022</time></div>
          <div>
            <h3 class="entry-title">Cloud Operations and Automation Engineer — Network Domain</h3>
            <p class="entry-org">Ericsson</p>
            <div class="entry-loc">Cairo, Egypt</div>
            <div class="entry-body">
              <p class="body">Joined Ericsson as an operations engineer, with main responsibility for automating tedious bug checks that customers may face and automating fix application with minimal customer intervention, using mainly Python and Bash scripting.</p>
            </div>
          </div>
        </div>

        <div class="entry">
          <div class="entry-date"><time datetime="2021-08">08/2021</time> — <time datetime="2022-10">10/2022</time></div>
          <div>
            <h3 class="entry-title">Public Cloud Operations Engineer — Network Domain</h3>
            <p class="entry-org">Orange Business Services</p>
            <div class="entry-loc">Cairo, Egypt</div>
            <div class="entry-body">
              <p class="body">Worked on both the physical and virtual parts of the cloud DC infrastructure, as follows:</p>

              <h4 style="font-size: var(--text-base); font-weight: bold; margin-top: var(--space-4); margin-bottom: var(--space-2);">Physical Networks</h4>
              <ul class="bullets">
                <li>Working on the physical DCs hosting all cloud services, adhering to current CLOS design standards and using APIs to configure and control network nodes (routers, switches, firewalls).</li>
                <li>Management and optimization of network capacity and peering with the Orange backbone for both MPLS and internet traffic.</li>
                <li>Exposure to multiple security appliances such as VPN gateways, Anti-DDoS and WAF — essential to any internet-facing solution, especially for hosting compliant and critical tenants.</li>
              </ul>

              <h4 style="font-size: var(--text-base); font-weight: bold; margin-top: var(--space-4); margin-bottom: var(--space-2);">Virtual Network</h4>
              <ul class="bullets">
                <li>For the first time in my career, I worked on the most upcoming technologies — OpenStack virtual networks and highly efficient virtual network appliances for security and load balancing.</li>
                <li>Worked with both legacy VLANs and new VXLAN virtual private networks, with multiple interworked encapsulation criteria.</li>
              </ul>

              <h4 style="font-size: var(--text-base); font-weight: bold; margin-top: var(--space-4); margin-bottom: var(--space-2);">Troubleshooting Experience</h4>
              <p class="body">From managing both physical and virtual networks, I worked on DC routing/switching alongside troubleshooting virtual networks, as traffic passes through security appliances and physical/virtual switches — so network operations extended even through the Linux machines.</p>

              <h4 style="font-size: var(--text-base); font-weight: bold; margin-top: var(--space-4); margin-bottom: var(--space-2);">Automation</h4>
              <ul class="bullets">
                <li>New to Terraform, but very experienced using Python for API interactions; also completed multiple large self-initiated projects (see the Projects section).</li>
              </ul>
              <p class="body">New DC technologies gave me the opportunity to migrate from SSH-based scripting to NetConf / REST API-based calls that are much more reliable and efficient.</p>
            </div>
          </div>
        </div>

        <div class="entry">
          <div class="entry-date"><time datetime="2019-06">06/2019</time> — <time datetime="2021-07">07/2021</time></div>
          <div>
            <h3 class="entry-title">IP Core Planning Senior Engineer</h3>
            <p class="entry-org">TE Data (Telecom Egypt) / WE</p>
            <div class="entry-loc">Cairo, Egypt</div>
            <div class="entry-body">
              <ul class="bullets">
                <li>Responsible for utilizing Python scripting for reporting on the whole backbone network and performing automated pre- and post-checks across an area while migrating critical devices.</li>
                <li>Implementation of backbone-hosted services and backhaul services for fixed, mobile, and broadband services using L3/L2 VPNs.</li>
                <li>Migration and implementation of backbone devices (P-PE-RR-BNG) from multiple vendors (Cisco, Juniper, Nokia, etc.).</li>
                <li>Software upgrades across multiple vendor devices.</li>
                <li>Deep understanding of BGP, MPLS & OSPF as the underlay for all hosted services.</li>
                <li>Due to the converged nature of the network, worked with mobile, fixed, and broadband backbones such as IMS, EPC, BNGs, and a suite of devices — also establishing connectivity toward multiple security devices (Palo Alto, Cisco ASA, Juniper SRX).</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="entry">
          <div class="entry-date"><time datetime="2018-06">06/2018</time> — <time datetime="2019-06">06/2019</time></div>
          <div>
            <h3 class="entry-title">VPN Implementation Engineer Level 3</h3>
            <p class="entry-org">Orange Business Services</p>
            <div class="entry-loc">Cairo, Egypt</div>
            <div class="entry-body">
              <ul class="bullets">
                <li>Worked on an international, vast network — gaining knowledge of how to manage enormous-scale networks.</li>
                <li>Supported customers across huge geographical areas and multiple languages; every enterprise worked with was global, enabling management of networks across multiple Autonomous Systems.</li>
                <li>Due to Orange Business Services' global reach, worked with multiple physical technologies, some phasing out — such as ATM and Frame Relay.</li>
                <li>Management of customer HUB sites with multiple unique network setups.</li>
                <li>Midway through the role, shifted to optimization technologies and devices such as Riverbed and Ipanema, gaining deep knowledge of TCP/IP operation.</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="entry">
          <div class="entry-date"><time datetime="2016-10">10/2016</time> — <time datetime="2018-06">06/2018</time></div>
