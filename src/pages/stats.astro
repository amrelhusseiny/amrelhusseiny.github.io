---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Stats" description="Visitor statistics for this blog.">
  <section class="section-head">
    <h1>Stats</h1>
    <span class="more-link">Last 12 months</span>
  </section>

  <section class="stats-summary">
    <p id="stats-total" class="stats-total">&ndash;</p>
    <p id="stats-total-label" class="stats-total-label">loading&hellip;</p>
  </section>

  <section id="heatmap-wrap">
    <div id="heatmap" class="stats-heatmap"></div>
  </section>

  <section class="page-section" style="margin-top:2rem;">
    <div class="section-head">
      <h2>About</h2>
    </div>
    <div class="post-content">
      <p>This page is powered by <a href="https://www.goatcounter.com/" target="_blank" rel="noopener">GoatCounter</a> — open-source, privacy-friendly, cookie-free analytics. Daily counts are fetched through a serverless function and rendered as a calendar heatmap.</p>
    </div>
  </section>

  <script>
    (async () => {
      const cell = (count: number, max: number) => {
        const idx = count === 0 ? 0 : Math.max(1, Math.min(4, Math.round((count / max) * 4)));
        return `<div class="stats-cell" data-level="${idx}" title="${count} visitors"></div>`;
      };

      try {
        const res = await fetch("/api/stats");
        const data = await res.json();
        // GoatCounter stats/total daily returns { stats: { total: { daily: { "2026-01-01": 5, ... } } } }
        const daily = data?.stats?.total?.daily || {};
        const entries = Object.entries(daily);
        const total = entries.reduce((s, [, v]) => s + (v as number), 0);
        const max = Math.max(1, ...entries.map(([, v]) => v as number));
        const totalEl = document.getElementById("stats-total");
        const labelEl = document.getElementById("stats-total-label");
        if (totalEl) totalEl.textContent = total.toLocaleString();
        if (labelEl) labelEl.textContent = "visits over the past year";

        // Group into weeks (columns) for a GitHub-style calendar
        const days = [];
        const now = new Date();
        for (let i = 364; i >= 0; i--) {
          const d = new Date(now.getFullYear(), now.getMonth(), now.getDate() - i);
          const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
          days.push({ key, count: daily[key] || 0 });
        }
        const weeks = [];
        for (let i = 0; i < days.length; i += 7) weeks.push(days.slice(i, i + 7));
        const wrap = document.getElementById("heatmap");
        if (!wrap) return;
        wrap.innerHTML = `<div style="display:flex;gap:3px;">${weeks.map(w =>
          `<div style="display:flex;flex-direction:column;gap:3px;">${w.map(d => cell(d.count, max)).join("")}</div>`
        ).join("")}</div>`;
      } catch (e) {
        const labelEl = document.getElementById("stats-total-label");
        if (labelEl) labelEl.textContent = "Stats not available yet — analytics start once GoatCounter is configured.";
        const totalEl = document.getElementById("stats-total");
        if (totalEl) totalEl.textContent = "–";
        const wrap = document.getElementById("heatmap-wrap");
        if (wrap) wrap.style.display = "none";
      }
    })();
  </script>
</Layout>
